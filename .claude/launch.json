{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "facebook-clone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "facebook-clone", "run", "dev"],
      "port": 3000
    },
    {
      "name": "facebook-clone-backend-mode",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "facebook-clone", "run", "dev:backend"],
      "port": 3000
    },
    {
      "name": "grooming-backend",
      "runtimeExecutable": "grooming-backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "grooming-backend", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
