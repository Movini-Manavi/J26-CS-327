# Grooming-detection demo
# mock = everything runs in the browser (no backend needed)
# http = talk to grooming-backend (FastAPI)
VITE_API_MODE=mock
VITE_API_URL=http://localhost:8000
# Shared key for /chatadmin (the backend must use the same value)
VITE_DEMO_KEY=demo-key
# Public VAPID key for guardian Web Push (from the backend)
VITE_VAPID_PUBLIC_KEY=
