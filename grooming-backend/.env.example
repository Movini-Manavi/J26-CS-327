# Copy to .env and adjust.

# Storage adapter: sqlite (mongo later)
DB_BACKEND=sqlite
SQLITE_PATH=./data/grooming.db

# Must match VITE_DEMO_KEY in the frontend
DEMO_KEY=demo-key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Any localhost port is allowed while developing; set to empty when hosted
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# Classifier: transformers = fine-tuned model folder below; stub = keyword list
CLASSIFIER=transformers
MODEL_DIR=./best_model
# Max tokens per message fed to the model
MAX_LENGTH=128

# Alert rule: alert when a message gets one of these stages
ALERT_STAGES=Trust-Building,Isolation,Desensitization,Solicitation

# Web Push (optional). Leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
